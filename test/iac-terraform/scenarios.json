{
    "install_opentofu_and_terragrunt": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "iac-terraform": {
                "tool": "opentofu",
                "installTerragrunt": true
            }
        }
    },
    "install_all_tools_including_infracost": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "iac-terraform": {
                "tool": "terraform",
                "installTerragrunt": true,
                "installInfracost": true
            }
        }
    }
}
