{
  "name": "Hello, World!",
  "id": "hello",
  "version": "0.1.0",
  "description": "A hello world feature",
  "options": {
    "greeting": {
      "type": "string",
      "proposals": [
        "hey",
        "hello",
        "hi",
        "howdy"
